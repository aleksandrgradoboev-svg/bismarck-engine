{
  "name": "gemini25-tool-ids",
  "note": "Control for gemini3-tool-ids (upstream cbaca6038): gemini major version 2 stays BELOW the requiresToolCallId() threshold, so functionCall / functionResponse parts must carry NO id. Proves the port moved the boundary rather than turning ids on for everything. LIMIT: pi's payload hook sees the @google/genai SDK call params, the Go port's sees the REST body, so only $.contents \u2014 the one artifact identical on both sides, and the one the tool call ids live in \u2014 is compared. Shipped in pi-ai 0.84.2; backend flipped to dist (README rule).",
  "backend": "dist",
  "api": "google-generative-ai",
  "entry": "streamSimple",
  "model": {
    "id": "gemini-2.5-flash",
    "name": "Gemini 2.5 Flash",
    "api": "google-generative-ai",
    "provider": "google",
    "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
    "reasoning": true,
    "input": [
      "text",
      "image"
    ],
    "cost": {
      "input": 0.3,
      "output": 2.5,
      "cacheRead": 0.03,
      "cacheWrite": 0
    },
    "contextWindow": 1048576,
    "maxTokens": 65536
  },
  "context": {
    "systemPrompt": "You call tools.",
    "messages": [
      {
        "role": "user",
        "content": "List /tmp then read a.txt",
        "timestamp": 1
      },
      {
        "role": "assistant",
        "content": [
          {
            "type": "text",
            "text": "Listing."
          },
          {
            "type": "toolCall",
            "id": "tc-alpha",
            "name": "list_dir",
            "arguments": {
              "path": "/tmp",
              "depth": 1,
              "all": true
            }
          },
          {
            "type": "toolCall",
            "id": "tc-beta",
            "name": "read_file",
            "arguments": {
              "path": "/tmp/a.txt"
            }
          }
        ],
        "api": "google-generative-ai",
        "provider": "google",
        "model": "gemini-2.5-flash",
        "usage": {
          "input": 12,
          "output": 7,
          "cacheRead": 0,
          "cacheWrite": 0
        },
        "stopReason": "toolUse",
        "timestamp": 2
      },
      {
        "role": "toolResult",
        "toolCallId": "tc-alpha",
        "toolName": "list_dir",
        "content": [
          {
            "type": "text",
            "text": "a.txt"
          }
        ],
        "isError": false,
        "timestamp": 3
      },
      {
        "role": "toolResult",
        "toolCallId": "tc-beta",
        "toolName": "read_file",
        "content": [
          {
            "type": "text",
            "text": "contents"
          }
        ],
        "isError": false,
        "timestamp": 4
      },
      {
        "role": "user",
        "content": "Summarize.",
        "timestamp": 5
      }
    ],
    "tools": [
      {
        "name": "list_dir",
        "description": "List a directory.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "depth": {
              "type": "number"
            },
            "all": {
              "type": "boolean"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "read_file",
        "description": "Read a file.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      }
    ]
  },
  "options": {
    "apiKey": "test-key",
    "reasoning": "high"
  },
  "comparePaths": [
    "$.contents"
  ],
  "orderSensitivePaths": [
    "$.contents[1].parts[1].functionCall.args",
    "$.contents[1].parts[2].functionCall.args"
  ]
}
