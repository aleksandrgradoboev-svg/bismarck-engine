{
  "name": "simple-tool-choice-openai-responses-unset",
  "note": "e5dde9a76: unset toolChoice stays absent on openai-responses. Shipped in pi-ai 0.84.3 (release 4e58f324f), so this scenario is backend:\"dist\" — captured against the published build, the stronger ground truth (README rule).",
  "backend": "dist",
  "api": "openai-responses",
  "entry": "streamSimple",
  "model": {
    "id": "gpt-5.6-sol",
    "name": "GPT-5.6 Sol",
    "api": "openai-responses",
    "provider": "openai",
    "baseUrl": "https://api.openai.com/v1",
    "reasoning": true,
    "input": [
      "text"
    ],
    "cost": {
      "input": 1.25,
      "output": 10,
      "cacheRead": 0.125,
      "cacheWrite": 0
    },
    "contextWindow": 400000,
    "maxTokens": 128000
  },
  "context": {
    "systemPrompt": "You are a helpful assistant.",
    "messages": [
      {
        "role": "user",
        "content": "Summarize the conversation.",
        "timestamp": 1
      }
    ],
    "tools": [
      {
        "name": "read_file",
        "description": "Read a file.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "list_dir",
        "description": "List a directory.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "depth": {
              "type": "number"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      }
    ]
  },
  "options": {
    "apiKey": "sk-test-key",
    "maxTokens": 1024
  }
}
