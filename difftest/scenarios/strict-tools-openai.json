{
  "name": "strict-tools-openai",
  "note": "Upstream 7915cdac6 (Go d3978d3): strict tool schema conversion. Requires PI_UPSTREAM_SHA >= 7915cdac6 (feature absent at earlier shas -> false FAIL). openai-completions wire: strict tool sends function.parameters = CONVERTED schema with strict:true; inconvertible strict-prefer tool falls back to ORIGINAL parameters with strict:false; plain tool sends original parameters with strict:false. Shipped in pi-ai 0.84.2; backend flipped to dist (README rule).",
  "backend": "dist",
  "api": "openai-completions",
  "entry": "stream",
  "model": {
    "id": "gpt-4o-mini",
    "name": "GPT-4o mini",
    "api": "openai-completions",
    "provider": "openai",
    "baseUrl": "https://api.openai.com/v1",
    "reasoning": false,
    "input": [
      "text"
    ],
    "cost": {
      "input": 0.15,
      "output": 0.6,
      "cacheRead": 0,
      "cacheWrite": 0
    },
    "contextWindow": 128000,
    "maxTokens": 16384
  },
  "context": {
    "systemPrompt": "You call tools.",
    "messages": [
      {
        "role": "user",
        "content": "Call conv.",
        "timestamp": 1
      }
    ],
    "tools": [
      {
        "name": "conv",
        "description": "Convertible tool.",
        "parameters": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "description": "Required string."
            },
            "optional": {
              "type": "number"
            },
            "metadata": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              }
            },
            "nullable": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "nullish": {
              "type": [
                "integer",
                "null"
              ]
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "k": {
                    "type": "string"
                  }
                },
                "required": [
                  "k"
                ]
              }
            },
            "empty": {
              "type": "object"
            }
          },
          "required": [
            "value",
            "metadata"
          ],
          "title": "ConvInput"
        },
        "constrainedSampling": {
          "type": "json_schema",
          "strict": "prefer"
        }
      },
      {
        "name": "fallback",
        "description": "Falls back.",
        "parameters": {
          "type": "object",
          "properties": {
            "child": {
              "$ref": "https://example.com/child.json"
            }
          },
          "required": [
            "child"
          ]
        },
        "constrainedSampling": {
          "type": "json_schema",
          "strict": "prefer"
        }
      },
      {
        "name": "plain",
        "description": "No constrained sampling.",
        "parameters": {
          "type": "object",
          "properties": {
            "q": {
              "type": "string"
            }
          },
          "required": [
            "q"
          ],
          "additionalProperties": false
        }
      }
    ]
  },
  "options": {
    "apiKey": "test-key",
    "maxTokens": 1024
  }
}