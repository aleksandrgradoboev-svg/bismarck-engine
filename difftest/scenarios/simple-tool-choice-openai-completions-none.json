{
  "name": "simple-tool-choice-openai-completions-none",
  "note": "e5dde9a76: unified toolChoice reaches openai-completions tool_choice. Shipped in pi-ai 0.84.3 (release 4e58f324f), so this scenario is backend:\"dist\" — captured against the published build, the stronger ground truth (README rule).",
  "backend": "dist",
  "api": "openai-completions",
  "entry": "streamSimple",
  "model": {
    "id": "gpt-4o-mini",
    "name": "GPT-4o mini",
    "api": "openai-completions",
    "provider": "openai",
    "baseUrl": "https://api.openai.com/v1",
    "reasoning": false,
    "input": [
      "text"
    ],
    "cost": {
      "input": 0.15,
      "output": 0.6,
      "cacheRead": 0,
      "cacheWrite": 0
    },
    "contextWindow": 128000,
    "maxTokens": 16384
  },
  "context": {
    "systemPrompt": "You are a helpful assistant.",
    "messages": [
      {
        "role": "user",
        "content": "Summarize the conversation.",
        "timestamp": 1
      }
    ],
    "tools": [
      {
        "name": "read_file",
        "description": "Read a file.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "list_dir",
        "description": "List a directory.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "depth": {
              "type": "number"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      }
    ]
  },
  "options": {
    "apiKey": "test-key",
    "maxTokens": 1024,
    "toolChoice": "none"
  }
}
