  },
  "orderSensitivePaths": [
    "$.messages[2].reasoning_details[0]",
    "$.messages[2].reasoning_details[1]",
    "$.messages[2].reasoning_details[0].zz_provider_meta"
  ],
  "options": {
    "apiKey": "test-key",
    "maxTokens": 1024
  }
