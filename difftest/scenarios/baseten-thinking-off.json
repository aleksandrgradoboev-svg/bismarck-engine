{
  "name": "baseten-thinking-off",
  "note": "Upstream c1019d920 (Go dbc464d), thinking OFF. With no reasoning level, $var thinking.enabled becomes false, omitWhenOff entries drop out, and $var thinking.effort resolves via thinkingLevelMap.off (null here => key omitted). reasoning_effort must be absent. chat_template_args key order is asserted. Shipped in pi-ai 0.84.2; backend flipped to dist (README rule).",
  "backend": "dist",
  "api": "openai-completions",
  "entry": "streamSimple",
  "orderSensitivePaths": [
    "$.chat_template_args"
  ],
  "model": {
    "id": "custom-baseten",
    "name": "Baseten reasoning model",
    "api": "openai-completions",
    "provider": "baseten",
    "baseUrl": "https://inference.baseten.co/v1",
    "reasoning": true,
    "input": [
      "text"
    ],
    "cost": {
      "input": 0,
      "output": 0,
      "cacheRead": 0,
      "cacheWrite": 0
    },
    "contextWindow": 128000,
    "maxTokens": 16384,
    "compat": {
      "thinkingFormat": "baseten",
      "supportsReasoningEffort": true,
      "chatTemplateArgs": {
        "thinking": {
          "$var": "thinking.enabled"
        },
        "effort": {
          "$var": "thinking.effort"
        },
        "literal": "x",
        "only_when_on": {
          "$var": "thinking.effort",
          "omitWhenOff": true
        }
      }
    },
    "thinkingLevelMap": {
      "minimal": null,
      "low": "low",
      "medium": "medium",
      "high": "high",
      "off": null
    }
  },
  "context": {
    "systemPrompt": "sys",
    "messages": [
      {
        "role": "user",
        "content": "think",
        "timestamp": 1
      }
    ]
  },
  "options": {
    "apiKey": "test-key"
  }
}
